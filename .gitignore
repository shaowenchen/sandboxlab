# Binaries built by `make build`. The published artifacts are images, so nothing
# here is committed.
/bin/

# Packaged charts, built by `make chart-package` for the gh-pages publish.
/dist/

# A local publish, built by `make chart-package` / `make docs`. In CI this is a
# worktree of gh-pages; locally it is scratch.
/pages/

# Runtime state a local `sandbox` serve writes: the API key it generated, the
# catalog it merged, logs.
/.sandboxlab/
/.sandbox-session/

# Coverage and test output.
*.out
coverage.txt

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
*.swp
